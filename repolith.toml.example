# Example: orchestrate a Rust toolchain spread across multiple sibling
# repositories. Drop this file into the directory where you want the
# clones + tool binaries to land, then run:
#
#   repolith sync --dry-run --explain    # preview
#   repolith sync                        # do the work
#
# `~` in `install_to` expands to your home directory at execute time.
#
# Replace `example-org/...` URLs and the local `path`s with the actual
# repos / locations for your stack.

[orchestrator]
schema_version = "0.1"
name = "my-stack"

# Foundation library — clone-only, no install. Iterations land in ../libs/.
[[node]]
id = "shared-types"
git = "https://github.com/example-org/shared-types"
path = "../libs/shared-types"

  [[node.action]]
  kind = "git-clone"

# Library that builds on shared-types.
[[node]]
id = "domain-engine"
git = "https://github.com/example-org/domain-engine"
path = "../libs/domain-engine"

  [[node.action]]
  kind = "git-clone"

# CLI tool — clone the source, then `cargo install --bin migrate` into ~/.local/bin.
[[node]]
id = "migration-tool"
git = "https://github.com/example-org/migration-tool"
path = "../tools/migration-tool"

  [[node.action]]
  kind = "git-clone"

  [[node.action]]
  kind = "cargo-install"
  crate = "migrate"                 # defaults to the node's `id` when absent
  features = ["postgres"]           # cargo features to enable (default: none)
  install_to = "~/.local/bin"       # defaults to ~/.repolith/bin when absent

# Same shape: clone + install another binary.
[[node]]
id = "ops-cli"
git = "https://github.com/example-org/ops-cli"
path = "../tools/ops-cli"

  [[node.action]]
  kind = "git-clone"

  [[node.action]]
  kind = "cargo-install"
  crate = "ops"
  install_to = "~/.local/bin"

# `[[attached]]` blocks are recognized by the parser for forward
# compatibility but currently do nothing — they ship with the M2
# `template_apply` action.
