# Example: orchestrate a Rust toolchain spread across multiple sibling
# repositories. Drop this file into the directory where you want the
# clones + tool binaries to land, then run:
#
#   repolith sync --dry-run --explain    # preview
#   repolith sync                        # do the work
#
# `~` in `install_to` expands to your home directory at execute time.
#
# Replace `example-org/...` URLs and the local `path`s with the actual
# repos / locations for your stack.

[orchestrator]
schema_version = "0.1"
name = "my-stack"

# Foundation library — clone-only, no install. Iterations land in ../libs/.
[[node]]
id = "shared-types"
git = "https://github.com/example-org/shared-types"
path = "../libs/shared-types"

  [[node.action]]
  kind = "git-clone"

# Library that builds on shared-types.
[[node]]
id = "domain-engine"
git = "https://github.com/example-org/domain-engine"
path = "../libs/domain-engine"

  [[node.action]]
  kind = "git-clone"

# CLI tool — clone the source, then `cargo install --bin migrate` into ~/.local/bin.
[[node]]
id = "migration-tool"
git = "https://github.com/example-org/migration-tool"
path = "../tools/migration-tool"

  [[node.action]]
  kind = "git-clone"

  [[node.action]]
  kind = "cargo-install"
  crate = "migrate"                 # BINARY name; defaults to the node's `id`
  # profile = "dev"                 # debug build — fast to compile, slow to run
  # package = "migration-tools"     # only when the source holds several
                                    # packages and cargo refuses to guess
  features = ["postgres"]           # cargo features to enable (default: none)
  install_to = "~/.local/bin"       # defaults to ~/.repolith/bin when absent

# Same shape: clone + install another binary.
[[node]]
id = "ops-cli"
git = "https://github.com/example-org/ops-cli"
path = "../tools/ops-cli"

  [[node.action]]
  kind = "git-clone"

  [[node.action]]
  kind = "cargo-install"
  crate = "ops"
  install_to = "~/.local/bin"

# Containerized service — clone, then `docker build` an image from the
# checkout. Build-only: repolith never runs containers.
[[node]]
id = "api-server"
git = "https://github.com/example-org/api-server"
path = "../services/api-server"

  [[node.action]]
  kind = "git-clone"

  [[node.action]]
  kind = "docker"
  tag = "example-org/api-server:latest"  # required
  dockerfile = "Dockerfile"              # default: Dockerfile (relative to context)
  context = "."                          # default: the node's `path`

# Federated sub-stack — the checkout contains its own repolith.toml,
# synced as a nested plan with its own local cache. Cycles are rejected,
# depth is capped at 8, and --jobs bounds the whole tree.
[[node]]
id = "platform-stack"
git = "https://github.com/example-org/platform-stack"
path = "../stacks/platform"

  [[node.action]]
  kind = "git-clone"

  [[node.action]]
  kind = "repolith"
  manifest = "repolith.toml"    # default — relative to the node's `path`

# `[[attached]]` blocks are recognized by the parser for forward
# compatibility but currently do nothing — they ship with the M2
# `template_apply` action.
